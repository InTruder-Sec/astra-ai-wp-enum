# ---------------------------------------------------------------------------
# AI provider (OPTIONAL)
# The tool auto-selects a provider from whichever key is present. With no key
# it runs in deterministic mode (no LLM) and still produces full results.
# If BOTH keys are set, AI_PROVIDER decides (defaults to openai).
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Force a provider when both keys exist: "openai" | "anthropic"
AI_PROVIDER=

# ---------------------------------------------------------------------------
# Target (OPTIONAL - can also be passed with --url)
# ---------------------------------------------------------------------------
WP_TARGET_URL=http://localhost:8090
